# Copie para .env e preencha os valores reais antes de subir produção
# NUNCA commite este arquivo com valores preenchidos

APP_VERSION=1.0.0

# Banco de dados
DB_NAME=agenday_prod
DB_USER=agenday
DB_PASSWORD=TROQUE_POR_SENHA_FORTE

# Redis
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE

# MinIO
MINIO_ACCESS_KEY=TROQUE_POR_ACCESS_KEY
MINIO_SECRET_KEY=TROQUE_POR_SECRET_KEY_LONGA

# JWT (mínimo 64 caracteres, random)
JWT_SECRET=TROQUE_POR_SECRET_ALEATORIO_DE_PELO_MENOS_64_CARACTERES
JWT_EXPIRATION_MS=86400000
